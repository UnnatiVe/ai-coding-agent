# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API server -------------------------------------------------------------
API_PORT=3001
# Comma-separated list of origins allowed to call the API / open SSE streams.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite; only VITE_* vars are exposed to the browser) -----------
VITE_API_URL=http://localhost:3001

# --- Postgres ---------------------------------------------------------------
# The POSTGRES_* vars configure the docker-compose container; DATABASE_URL is
# what Prisma reads. Keep them in sync when you change credentials or port.
POSTGRES_USER=aca
POSTGRES_PASSWORD=aca
POSTGRES_DB=aca
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://aca:aca@localhost:5432/aca?schema=public
# Optional: separate database used by integration tests.
# TEST_DATABASE_URL=postgresql://aca:aca@localhost:5432/aca_test?schema=public

# --- Redis (BullMQ queue + task event pub/sub) ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Worker -----------------------------------------------------------------
# Concurrent agent tasks per worker process. Keep at 1 until the sandbox
# (Phase 4) enforces per-task resource limits.
WORKER_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Phase 5+ placeholders. Unused today, listed so the shape is known.
# ---------------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
