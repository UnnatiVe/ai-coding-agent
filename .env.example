# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API server -------------------------------------------------------------
API_PORT=3001
# Comma-separated list of origins allowed to call the API / open SSE streams.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite; only VITE_* vars are exposed to the browser) -----------
VITE_API_URL=http://localhost:3001

# --- Postgres (consumed by docker-compose and Prisma) -----------------------
POSTGRES_USER=aca
POSTGRES_PASSWORD=aca
POSTGRES_DB=aca
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aca:aca@localhost:5432/aca?schema=public

# --- Redis (BullMQ queue + run event pub/sub) -------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Phase 2+ placeholders. Unused in Phase 1, listed so the shape is known.
# ---------------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
